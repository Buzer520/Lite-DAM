# 生产环境配置文件
# 域名: mypsp.cn
# 服务器IP: 8.146.232.61

# 数据库配置 - 使用 SQLite（生产环境建议使用 PostgreSQL）
DB_TYPE=sqlite
DB_PATH=./lite-dam.db

# PostgreSQL 生产配置（如需使用请取消注释并配置）
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=lite-dam-user
# DB_PASSWORD=your-strong-db-password
# DB_DATABASE=lite-dam

# JWT 配置 - 生产环境必须使用强密钥
JWT_SECRET=7f2a9d4e8b5c3f1a6e9d2b5c8f1a3e6d9b2a5c8f1e4a7d2b5c8f3a6e9d2b5c8f

# 服务器端口
PORT=3000

# 上传文件目录
UPLOAD_DIR=./uploads

# 存储配额（字节），默认 1GB
DEFAULT_STORAGE_QUOTA=1073741824

# Node 环境
NODE_ENV=production

# CORS 配置 - 生产环境指定具体域名
CORS_ORIGIN=https://mypsp.cn