# 生产环境配置文件
# 部署前请根据实际情况修改以下配置

# 数据库配置 - 使用 PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lite-dam-user
DB_PASSWORD=your-strong-db-password
DB_DATABASE=lite-dam

# JWT 配置 - 生产环境必须使用强密钥
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_YOUR_STRONG_JWT_SECRET_KEY_32_BYTES_MINIMUM

# 服务器端口
PORT=3000

# 上传文件目录
UPLOAD_DIR=/var/www/lite-dam/uploads

# 存储配额（字节），默认 1GB
DEFAULT_STORAGE_QUOTA=1073741824

# Node 环境
NODE_ENV=production

# CORS 配置 - 生产环境指定具体域名
CORS_ORIGIN=https://your-domain.com