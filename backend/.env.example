# 数据库配置
DB_TYPE=sqlite
DB_PATH=./lite-dam.db

# PostgreSQL 生产配置（取消注释并填写）
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your-db-password
# DB_DATABASE=lite-dam

# JWT 配置（必填，必须使用强密码，建议 32 位以上随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 服务器端口
PORT=3000

# 上传文件目录
UPLOAD_DIR=./uploads

# 存储配额（字节），默认 1GB
DEFAULT_STORAGE_QUOTA=1073741824

# Node 环境
NODE_ENV=production